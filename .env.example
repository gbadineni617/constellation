# Server-side only. Never prefix with NEXT_PUBLIC_ or it ships to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Without this the app still runs, but nothing is saved.
# Neon:            https://neon.tech  ->  Connection string
# Vercel Postgres: Storage tab -> .env.local tab
# Local:           postgresql://localhost:5432/constellation
DATABASE_URL=

# Smartcat. Two different values — people mix these up.
#   SMARTCAT_ACCOUNT_ID is the Account ID shown in Settings > API. It is the username.
#   SMARTCAT_API_KEY is a key you create there with CREATE NEW KEY. It is the password.
# Server: us (default), eu, or ea.
SMARTCAT_ACCOUNT_ID=
SMARTCAT_API_KEY=
SMARTCAT_SERVER=us

# Protects /api/intake/run from being triggered by anyone. Any random string.
CRON_SECRET=

# Shared secret for the API. Leave empty locally; set it anywhere reachable from
# the internet, and set NEXT_PUBLIC_CONSTELLATION_KEY to the same value so the
# app sends it. This answers "is this our app", not "who is this person" — real
# per-user auth arrives with the move into the Smartcat workspace.
CONSTELLATION_KEY=
NEXT_PUBLIC_CONSTELLATION_KEY=

# Extra CORS origins during development, comma separated. Never set in production.
ALLOWED_ORIGINS=

# Optional override
# CONSTELLATION_MODEL=claude-sonnet-5
